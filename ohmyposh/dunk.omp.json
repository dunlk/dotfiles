{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "python",
          "style": "plain",
          "foreground": "#FFA500",
          "template": "{{ if .Venv }}(.env) {{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "green",
          "template": "{{ .Folder }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "magenta",
          "template": "on {{ .HEAD }}{{ if .Working.Changed }} ✗{{ end }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "red",
          "template": "{{ if gt .Code 0 }}[{{ .Code }}] {{ end }}"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "yellow",
          "template": "❯"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 5
}
